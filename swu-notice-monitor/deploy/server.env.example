# Public-network server: do not inherit desktop proxy settings.
SWU_NETWORK_MODE=direct
SWU_HTTPS_PROXY=
SWU_ALLOWED_ORIGINS=https://notices.example.edu.cn
SWU_WEB_PORT=8080
# If the server requires an egress proxy, use:
# SWU_NETWORK_MODE=proxy
# SWU_HTTPS_PROXY=http://proxy-host-accessible-from-container:3128
# Container 127.0.0.1 is not the host machine or your desktop.
